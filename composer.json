{
    "name": "laboiteacode/filament-tribute-theme",
    "description": "A free Filament v5 theme paying tribute to filamentphp.com: cream corner-tick cards, honey pill buttons and Outfit headings, built on Filament's own CSS variables.",
    "keywords": [
        "laboiteacode",
        "filament",
        "filament-theme",
        "filament-plugin",
        "filament-tribute-theme",
        "theme",
        "tribute"
    ],
    "homepage": "https://github.com/La-boite-a-code/Filament-Tribute-Theme",
    "support": {
        "issues": "https://github.com/La-boite-a-code/Filament-Tribute-Theme/issues",
        "source": "https://github.com/La-boite-a-code/Filament-Tribute-Theme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "La Boite à Code",
            "email": "alexandre@laboiteacode.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-arch": "^3.1 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0 || ^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Laboiteacode\\FilamentTributeTheme\\": "src/",
            "Laboiteacode\\FilamentTributeTheme\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laboiteacode\\FilamentTributeTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laboiteacode\\FilamentTributeTheme\\FilamentTributeThemeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
