# Keep the dist archive lean: ship the PHP sources, the source stylesheet and
# the published stub, and nothing else. The README loads its images from
# GitHub, so the art folder stays out of the archive.
/art                    export-ignore
/.github                export-ignore
/tests                  export-ignore
/resources/css/build.css export-ignore
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/CHANGELOG.md           export-ignore
/package.json           export-ignore
/phpstan-baseline.neon  export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/pint.json              export-ignore
/vite.config.js         export-ignore
